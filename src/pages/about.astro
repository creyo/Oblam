---
import Layout from '../layouts/Layout.astro';
import Top from '../components/oblam/Top.astro';
import AboutUsHero from '../components/oblam/AboutUsHero.astro';
import Mission from '../components/oblam/Mission.astro';
import LastBlock from '../components/oblam/LastBlock.astro';
import { frontmatter } from '../content/about.mdx';

const topItem = frontmatter.data.find((c) => c.section === 'Top' && (c.publish || 'Y').toUpperCase() === 'Y');

const heroItem = frontmatter.data.find((c) => c.section === 'Hero' && (c.publish || 'Y').toUpperCase() === 'Y');

const missionItems = frontmatter.data.filter((c) => c.section === 'Mission' && (c.publish || 'Y').toUpperCase() === 'Y').sort((a, b) => Number(a.order || 0) - Number(b.order || 0));

const lastblockItem = frontmatter.data.find((c) => c.section === 'LastBlock' && (c.publish || 'Y').toUpperCase() === 'Y');


---
<Layout
  title={frontmatter.metaTitle || "About Us"}
  description={frontmatter.metaDescription || "Default description"}
>
{topItem && <Top {...topItem} folderPath="about" />}
{heroItem && <AboutUsHero {...heroItem} folderPath="about" />}
{missionItems.length > 0 && <Mission items={missionItems} folderPath="about" />}
{lastblockItem && <LastBlock {...lastblockItem} folderPath="about" />}

</Layout>
