---
import Layout from '../layouts/Layout.astro';
import Body from '../components/oblam/Body.astro';
import { frontmatter } from '../content/terms-conditions.mdx';

const bodyItem = frontmatter.data.find((c) => c.section === 'Body' && (c.publish || 'Y').toUpperCase() === 'Y');


---
<Layout
  title={frontmatter.metaTitle || "Terms & Conditions"}
  description={frontmatter.metaDescription || "Default description"}
>
{bodyItem && <Body {...bodyItem} folderPath="terms-conditions" />}

</Layout>
